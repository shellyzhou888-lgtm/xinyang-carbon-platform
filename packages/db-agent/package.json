{
  "name": "@xinyang/db-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "数据库 Agent（Pi 架构 + DeepSeek）：自然语言查询园区能碳数据、解释指标、试算",
  "scripts": {
    "chat": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts src/voice-tools.ts --bundle --splitting --platform=node --format=esm --target=node22 --packages=external --outdir=dist --out-extension:.js=.mjs",
    "govern": "tsx src/govern-cli.ts",
    "trajectories": "tsx src/trajectory-export.ts",
    "eval": "tsx src/eval.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./voice": {
      "types": "./src/voice-tools.ts",
      "default": "./dist/voice-tools.mjs"
    }
  }
}
