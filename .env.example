# 仅作配置示例。复制到本机 .env 后填写密码；.env 不提交 GitHub。
# 开发时先建立 SSH 隧道，将本机 15432 端口转发至服务器的 127.0.0.1:5432。
# 网站运行时使用应用账户；超级用户只用于独立的管理和迁移操作。
DATABASE_URL="postgresql://zyz:<URL编码后的应用账户密码>@127.0.0.1:15432/greensystem"

# 数据库 Agent（packages/db-agent）
DEEPSEEK_API_KEY="<DeepSeek API Key，只写在本机 .env>"
# 可选：deepseek-flash（默认）或 deepseek-v4-pro
DEEPSEEK_MODEL="deepseek-flash"
# 可选：auto 全自动 / confirm 写操作前在终端确认 / off 只读
AGENT_WRITE_MODE="auto"
# 可选：off / low / medium / high
AGENT_THINKING="off"
AGENT_MAX_TOOL_CALLS=20
AGENT_SQL_ROW_LIMIT=200
AGENT_SQL_TIMEOUT_MS=5000

# 网站登录（写在 apps/web/.env.local，不提交 Git）：账号、密码与会话签名密钥（任意长随机串）
# AUTH_USERNAME="admin"
# AUTH_PASSWORD="<登录密码>"
# AUTH_SECRET="<32 字节以上随机串>"
